# Next-Cash Production Configuration Template
# Salin berkas ini ke .env sebelum menjalankan container

# Port server (default: 3001)
PORT=3001

# Lingkungan runtime (production / development)
NODE_ENV=production

# Kunci rahasia sesi & CSRF (wajib diganti dengan string acak aman di production)
SESSION_SECRET=ganti-dengan-kunci-rahasia-acak-minimal-32-karakter

# Auto-seed data akun awal jika database baru pertama kali dibuat (true/false)
AUTO_SEED=true

# Lokasi penyimpanan database SQLite dan berkas nota di dalam container
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# Path spesifik database (opsional, jika ingin mengarahkan file .sqlite secara kustom)
# DATABASE_PATH=/app/data/nextcash.sqlite

