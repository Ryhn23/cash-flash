  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "dev": "tsx server/src/dev-runner.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/src/index.ts --platform=node --format=esm --packages=external --bundle --outfile=dist/server/index.js",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "compose:ps": "docker compose ps",
    "db:seed": "tsx server/src/db/seed.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
